{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hacker-house-medellin-test/contract-conformance-tests/contracts/platform/json-schema/contract.schema.json",
  "$defs": {
    "ReservationContract": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ReservationContract",
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "enabled": { "type": "boolean" },
        "owner": { "type": "string" }
      },
      "required": ["repository", "enabled"],
      "unevaluatedProperties": false
    }
  }
}
